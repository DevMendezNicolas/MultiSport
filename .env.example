# MultiSport - Docker Environment Configuration Template
# Copy this file to '.env' for local Docker overrides.
# NOTE: Never commit '.env' containing real secrets to Git.

# PostgreSQL Configuration
POSTGRES_DB=multisport_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_PORT=5432

# pgAdmin 4 Configuration
PGADMIN_DEFAULT_EMAIL=admin@multisport.com
PGADMIN_DEFAULT_PASSWORD=adminpassword
PGADMIN_PORT=5050
