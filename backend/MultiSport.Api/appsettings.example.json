{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=multisport_dev;Username=postgres;Password=REPLACE_WITH_DB_PASSWORD;"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Jwt": {
    "Secret": "REPLACE_WITH_JWT_SECRET_MIN_32_CHARS_LONG",
    "Issuer": "MultiSport.Api",
    "Audience": "MultiSport.Client",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenIdleTimeoutMinutes": 30,
    "RefreshTokenAbsoluteExpirationHours": 24,
    "ResetTokenExpirationMinutes": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://app.multisport.com"
    ]
  },
  "AllowedHosts": "*"
}
